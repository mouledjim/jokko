# Copier ce fichier en `.env` et renseigner les valeurs depuis le dashboard Supabase.
# Project Settings -> API Keys
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Cle secrete (sb_secret_... ou service_role legacy) : UNIQUEMENT pour scripts/seed.ts en local.
# Ne jamais l'importer dans src/ — elle ne doit jamais atteindre le bundle client.
SUPABASE_SERVICE_ROLE_KEY=
# Mot de passe base de donnees (Project Settings -> Database) : pour scripts/migrate.ts.
SUPABASE_DB_PASSWORD=
